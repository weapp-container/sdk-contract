{
  "name": "@weapp-container/sdk-contract",
  "version": "0.1.0-preview.7.0",
  "type": "module",
  "license": "Apache-2.0",
  "description": "Public embedding contracts and authorized runtime artifact tooling; no runtime implementation",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "pack:check": "npm pack --dry-run --ignore-scripts",
    "release:publish": "node tools/publish-npm.mjs",
    "docs:check": "node tools/documentation/check.mjs && node tools/documentation/check-content.mjs"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "preview"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weapp-container/sdk-contract.git"
  },
  "types": "types/weapp-container.d.ts",
  "files": [
    "include",
    "types",
    "tools/runtime-artifacts.mjs",
    "tools/unpack-runtime.py",
    "fixtures",
    "CONTRACT.md",
    "FLUTTER_PROTOCOL.md",
    "runtime-artifacts.schema.json",
    "runtime-artifacts.lock.json",
    "platforms.json",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./types/weapp-container.d.ts"
    },
    "./runtime-artifacts": "./tools/runtime-artifacts.mjs",
    "./fixtures": "./fixtures/make-acceptance-pack.mjs",
    "./include/*": "./include/*",
    "./runtime-artifacts.schema.json": "./runtime-artifacts.schema.json",
    "./package.json": "./package.json"
  }
}
